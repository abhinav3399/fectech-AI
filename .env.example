# Qdrant (Memory)
QDRANT_MODE=server
QDRANT_URL=https://xyz.qdrant.tech, QDRANT_API_KEY=your_key

# Groq (AI Model)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Free local AI (install Ollama, then run: ollama pull llama3.2:3b)
# LOCAL_AI_FIRST means the local model is used whenever it is reachable;
# a cloud key is only a fallback.
LOCAL_AI_FIRST=true
# Set false for a hard local-only install: no cloud chat client is created at all.
CLOUD_AI_ENABLED=true
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Local image->3D worker (bundled; no API key or GPU)
MODEL_3D_PROVIDER=local
MODEL_3D_URL=http://127.0.0.1:8800
MODEL_3D_TIMEOUT=45
# Optional shared secret. Set the same value for the backend and every local worker.
# LOCAL_WORKER_TOKEN=change-me

# Optional official DECA integration (non-commercial license; isolated runtime)
# MODEL_3D_PIPELINE=DECA
# DECA_ROOT=./vendor/DECA
# DECA_PYTHON=./deca-env/Scripts/python.exe
# DECA_DEVICE=cpu
# DECA_RASTERIZER=pytorch3d
