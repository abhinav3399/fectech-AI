# Qdrant (Memory)
QDRANT_MODE=server
QDRANT_URL=https://xyz.qdrant.tech, QDRANT_API_KEY=your_key

# Groq (AI Model)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Free local AI fallback (install Ollama, then run: ollama pull llama3.2:3b)
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Optional official DECA integration (non-commercial license; isolated runtime)
# MODEL_3D_PIPELINE=DECA
# DECA_ROOT=./vendor/DECA
# DECA_PYTHON=./deca-env/Scripts/python.exe
# DECA_DEVICE=cpu
# DECA_RASTERIZER=pytorch3d
